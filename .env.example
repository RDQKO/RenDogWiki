# Production: use a Supabase pooled Postgres connection string. Never prefix secrets with NEXT_PUBLIC_.
DATABASE_URL=postgres://USER:PASSWORD@YOUR_POOLER_HOST:6543/postgres
DB_CONNECTION_MODE=pooled
DB_IDLE_TIMEOUT_SECONDS=60
# DIRECT_DB_URL is optional and is only used with DB_CONNECTION_MODE=direct.
# DIRECT_DB_URL=postgres://USER:PASSWORD@YOUR_DB_HOST:5432/postgres
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
MANAGE_DELETE_PASSWORD=REPLACE_WITH_A_PRIVATE_DELETE_PASSWORD
NEXT_PUBLIC_SITE_URL=https://ren-dog-wiki.vercel.app
NEXT_PUBLIC_CDN_BASE=https://d1y7k8qotewoph.cloudfront.net
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
ABLY_API_KEY=
EMAIL_FROM=
EMAIL_PASS=
# Local fixture only: DB_SSL=disable works only with a loopback DB host.
